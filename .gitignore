# A parent repository's .gitignore may ignore 'data/', 'build/' and '*.csv'; this project needs them,
# so re-include it here and then ignore only what must not be committed (raw HITRAN: licence).
!data/
!data/**/*.csv
!web/public/data/
!build/

.venv/
__pycache__/
*.egg-info/
.pytest_cache/
node_modules/
web/dist/
.DS_Store
# raw HITRAN line lists: licence forbids redistribution
data/raw/hitran/
data/cache/
data/raw/hitran_xsec/
